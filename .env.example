# All optional - defaults shown.
NIMIQ_NETWORK=MainAlbatross      # or TestAlbatross
STAKE_NIM=100                    # NIM staked per pool wallet (protocol minimum: 100)
FEE_TOLERANCE=0.01               # flag a pool when real fee exceeds listed fee by more than this (0.01 = 1 pp)
TICK_SECONDS=120
POOL_SYNC_MINUTES=15
WEB_PORT=3000
# POOL_EXCLUDE=NQ85 EA0M ...,NQ12 M1PJ ...    # never fund/monitor these validators. Unset = Nova Pool + Techbits
#                                             # Validator (listed but not operational); empty = exclude nothing
# POOL_ALLOWLIST=NQ15 HNAH ...,NQ96 X97C ...   # only monitor these validators (cheap trial run)
# WALLET_MNEMONIC=                # restore an existing seed; otherwise one is generated into the data volume
